<?xml version="1.0" encoding="utf-8"?>
<!--
  Only used for two global actions: lock the screen and open the shade.
  It reads no content, and only listens to NIHIL's own windows.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/lock_service_description"
    android:notificationTimeout="1000"
    android:packageNames="com.nihilshell.launcher" />
