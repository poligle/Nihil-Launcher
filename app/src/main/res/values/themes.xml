<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Settings and the wallpaper studio: opaque black -->
    <style name="Theme.Nihil" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/nihil_void</item>
        <item name="android:colorBackground">@color/nihil_void</item>
        <item name="android:colorAccent">@color/nihil_ink</item>
        <item name="android:colorControlActivated">@color/nihil_ink</item>
        <item name="android:textColorPrimary">@color/nihil_ink</item>
        <item name="android:textColorHint">@color/nihil_muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- The home screen: the system wallpaper behind it -->
    <style name="Theme.Nihil.Home" parent="@android:style/Theme.DeviceDefault.Wallpaper.NoTitleBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">@color/nihil_ink</item>
        <item name="android:colorControlActivated">@color/nihil_ink</item>
        <item name="android:textColorPrimary">@color/nihil_ink</item>
        <item name="android:textColorHint">@color/nihil_muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
